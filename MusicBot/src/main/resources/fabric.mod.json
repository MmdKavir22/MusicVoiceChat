{
  "schemaVersion": 1,
  "id": "musicbot",
  "version": "${version}",
  "name": "MusicBot",
  "description": "Client-side music player that mixes audio into your Simple Voice Chat microphone stream.",
  "authors": ["MmdKavir"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.mmdkavir.musicbot.MusicBotClient"],
    "voicechat": ["com.mmdkavir.musicbot.MusicBotVoicechatPlugin"]
  },
  "depends": {
    "minecraft": ">=${mcversion}",
    "java": ">=25",
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "voicechat": "*"
  }
}
